+  // Same path Social Posts uses: pick a local image/*, park it in the public
+  // social-assets bucket, and keep the permanent public URL on imageUrl.
+  const uploadImageFile = async (file) => {
+    if (!file) return;
+    if (!file.type || !String(file.type).startsWith("image/")) {
+      setImageMsg("Choose an image file (JPEG, PNG, WebP, etc.).");
+      return;
+    }
+    if (file.size > 25 * 1024 * 1024) {
+      setImageMsg("That image is over 25 MB — shrink it first.");
+      return;
+    }
+    if (!db) {
+      setImageMsg("Storage is unavailable right now.");
+      return;
+    }
+    setImageBusy(true);
+    setImageMsg("Uploading…");
+    try {
+      const ext = (file.name.split(".").pop() || "jpg")
+        .toLowerCase()
+        .replace(/[^a-z0-9]/g, "");
+      const path =
+        new Date().toISOString().slice(0, 10) +
+        "/" +
+        Math.random().toString(36).slice(2, 10) +
+        "." +
+        ext;
+      const { error } = await db.storage
+        .from("social-assets")
+        .upload(path, file, { contentType: file.type, upsert: false });
+      if (error) throw new Error(error.message || "Upload failed");
+      const { data } = db.storage.from("social-assets").getPublicUrl(path);
+      if (!data || !data.publicUrl) throw new Error("Could not get a public URL.");
+      setImageUrl(data.publicUrl);
+      setImageIn("");
+      setImageMsg("Uploaded — this copy is permanent.");
+    } catch (e) {
+      setImageMsg("Upload failed: " + String((e && e.message) || e));
+    }
+    setImageBusy(false);
+  };
